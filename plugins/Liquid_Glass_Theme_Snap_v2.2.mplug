{
  "id": "liquid-glass-snap",
  "name": "Liquid Glass Theme + Windows Snap",
  "version": "2.2.0",
  "description": "Selectable Liquid Glass system theme (mpkg-compatible colours) with original glass look, live blur/warp/motion controls, and smooth Windows 11-style snapping.",
  "kind": "mplug",
  "hooks": [
    "boot"
  ],
  "js": "(() => {\n'use strict';\n\n/*\n * Mica OS Pyron \u2014 Liquid Glass Theme + Snap\n * v2.2.0\n *\n * Liquid Glass is a REAL selectable theme (mpkg-compatible):\n *   \u2022 Registers via API.themesSave with solid semantic colours\n *     (--text light, --win-bg solid dark) so primary-btn, hovers,\n *     and OS light-theme fallbacks work correctly.\n *   \u2022 Glass CSS is scoped to body.theme-liquid-glass only.\n *   \u2022 Visual glass style matches the original v2.0 look (not darkened).\n *\n * Snap: Windows 11-style edge/corner, smooth restore, max = maximise.\n */\n\nconst PLUGIN_ID = 'liquid-glass-snap';\nconst STYLE_ID = 'mplug-liquid-glass-theme-style';\n\nconst STORAGE = {\n  blur: 'mplug_lg_blur',\n  warp: 'mplug_lg_warp',\n  motion: 'mplug_lg_motion'\n};\n\nconst defaults = { blur: 28, warp: 38, motion: 100 };\n\nfunction num(key, fallback, min, max) {\n  const v = Number(localStorage.getItem(key));\n  return Number.isFinite(v) ? Math.max(min, Math.min(max, v)) : fallback;\n}\n\nfunction ensureCSS() {\n  if (document.getElementById(STYLE_ID)) return;\n\n  const style = document.createElement('style');\n  style.id = STYLE_ID;\n  style.textContent = `\n/* ============================================================\n   LIQUID GLASS THEME  (original v2.0 visual style restored)\n   Layout untouched. Semantic colours come from the mpkg theme.\n   ============================================================ */\n\nbody.theme-liquid-glass {\n  --lg-blur: ${defaults.blur}px;\n  --lg-warp: ${defaults.warp};\n  --lg-motion: ${defaults.motion}ms;\n\n  --lg-fill:\n    color-mix(in srgb, var(--win-bg, #1c1d22) 64%,\n      rgba(255,255,255,0.11));\n  --lg-fill-soft: rgba(255,255,255,0.055);\n  --lg-fill-hover: rgba(255,255,255,0.125);\n  --lg-border: rgba(255,255,255,0.19);\n  --lg-border-strong: rgba(255,255,255,0.28);\n  --lg-shadow:\n    0 18px 55px rgba(0,0,0,.25),\n    0 5px 18px rgba(0,0,0,.14),\n    inset 0 1px 0 rgba(255,255,255,.20);\n  --lg-shadow-small:\n    0 10px 28px rgba(0,0,0,.18),\n    inset 0 1px 0 rgba(255,255,255,.14);\n\n  --anim:\n    cubic-bezier(.16,1,.3,1) var(--lg-motion);\n\n  --blur: blur(var(--lg-blur)) saturate(175%);\n  --dock-bg: rgba(20,20,24,.56);\n  --dock-border: var(--lg-border);\n  --input-bg: rgba(255,255,255,.055);\n  --well-bg: rgba(255,255,255,.075);\n  --lg-win-glass: rgba(25,27,34,.68);\n}\n\n/* Core shell surfaces \u2014 original look */\nbody.theme-liquid-glass #taskbar,\nbody.theme-liquid-glass #vertical-bubble,\nbody.theme-liquid-glass #quick-access,\nbody.theme-liquid-glass #start-menu,\nbody.theme-liquid-glass .topbar-dd-menu,\nbody.theme-liquid-glass .studio-dd-menu,\nbody.theme-liquid-glass .context-menu,\nbody.theme-liquid-glass .mica-menu,\nbody.theme-liquid-glass .tv-panel,\nbody.theme-liquid-glass .mica-modal-card,\nbody.theme-liquid-glass .qa-settings-card,\nbody.theme-liquid-glass .qa-cc-card,\nbody.theme-liquid-glass .sw-card {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.12) 0%,\n      rgba(255,255,255,.035) 48%,\n      rgba(255,255,255,.085) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n}\n\n/* App windows \u2014 original glass */\nbody.theme-liquid-glass .window {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.105) 0%,\n      rgba(255,255,255,.028) 52%,\n      rgba(255,255,255,.075) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n}\n\n/* Headers \u2014 original soft glass */\nbody.theme-liquid-glass .win-header,\nbody.theme-liquid-glass .jade-toolbar,\nbody.theme-liquid-glass .studio-menubar,\nbody.theme-liquid-glass .studio-toolbar {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.10),\n      rgba(255,255,255,.028)\n    ) !important;\n  border-color: rgba(255,255,255,.13) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .68)) saturate(165%) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .68)) saturate(165%) !important;\n}\n\n/* Content panes */\nbody.theme-liquid-glass .win-content,\nbody.theme-liquid-glass .jade-sidebar,\nbody.theme-liquid-glass .sm-body,\nbody.theme-liquid-glass .sm-main {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.018),\n      rgba(255,255,255,.005)\n    ) !important;\n}\n\nbody.theme-liquid-glass .jade-sidebar,\nbody.theme-liquid-glass .sm-side {\n  background: rgba(255,255,255,.035) !important;\n  border-color: rgba(255,255,255,.12) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .60)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .60)) !important;\n}\n\n/* Interactive surfaces \u2014 original */\nbody.theme-liquid-glass .bubble-btn,\nbody.theme-liquid-glass .tb-start-btn,\nbody.theme-liquid-glass .tb-app-btn,\nbody.theme-liquid-glass .sm-tile,\nbody.theme-liquid-glass .sm-list-item,\nbody.theme-liquid-glass .sm-app,\nbody.theme-liquid-glass .sm-search,\nbody.theme-liquid-glass .sm-side button,\nbody.theme-liquid-glass .qa-chip,\nbody.theme-liquid-glass .qa-st,\nbody.theme-liquid-glass .qa-tile,\nbody.theme-liquid-glass .qa-slider-block,\nbody.theme-liquid-glass .qa-slider-row,\nbody.theme-liquid-glass .topbar-menu-item,\nbody.theme-liquid-glass .context-item,\nbody.theme-liquid-glass .mc-card,\nbody.theme-liquid-glass .mc-under-app,\nbody.theme-liquid-glass .wp-preset-card,\nbody.theme-liquid-glass .store-item,\nbody.theme-liquid-glass .tb-instance-card {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    ) !important;\n  border-color: rgba(255,255,255,.13) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.09) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .58)) saturate(155%) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .58)) saturate(155%) !important;\n}\n\n/* Hover \u2014 original */\nbody.theme-liquid-glass .bubble-btn,\nbody.theme-liquid-glass .tb-start-btn,\nbody.theme-liquid-glass .tb-app-btn,\nbody.theme-liquid-glass .sm-tile,\nbody.theme-liquid-glass .sm-list-item,\nbody.theme-liquid-glass .sm-app,\nbody.theme-liquid-glass .qa-chip,\nbody.theme-liquid-glass .qa-tile,\nbody.theme-liquid-glass .topbar-menu-item,\nbody.theme-liquid-glass .context-item,\nbody.theme-liquid-glass .wp-preset-card {\n  transition:\n    background var(--anim),\n    border-color var(--anim),\n    box-shadow var(--anim),\n    transform var(--anim),\n    opacity var(--anim);\n}\n\nbody.theme-liquid-glass .bubble-btn:hover,\nbody.theme-liquid-glass .tb-start-btn:hover,\nbody.theme-liquid-glass .tb-app-btn:hover,\nbody.theme-liquid-glass .sm-tile:hover,\nbody.theme-liquid-glass .sm-list-item:hover,\nbody.theme-liquid-glass .sm-app:hover,\nbody.theme-liquid-glass .qa-chip:hover,\nbody.theme-liquid-glass .qa-tile:hover,\nbody.theme-liquid-glass .topbar-menu-item:hover,\nbody.theme-liquid-glass .context-item:hover,\nbody.theme-liquid-glass .wp-preset-card:hover {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.16),\n      rgba(255,255,255,.045)\n    ) !important;\n  border-color: var(--lg-border-strong) !important;\n  box-shadow:\n    0 8px 24px rgba(0,0,0,.11),\n    inset 0 1px 0 rgba(255,255,255,.19) !important;\n}\n\n/* Liquid highlight \u2014 original */\nbody.theme-liquid-glass #vertical-bubble::after,\nbody.theme-liquid-glass #start-menu::after,\nbody.theme-liquid-glass #quick-access::after,\nbody.theme-liquid-glass .window::after,\nbody.theme-liquid-glass .mica-modal-card::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  border-radius: inherit;\n  background:\n    radial-gradient(\n      115% 70% at calc(15% + (var(--lg-warp) * .55)% ) -8%,\n      rgba(255,255,255,.18),\n      transparent 42%\n    ),\n    radial-gradient(\n      80% 90% at calc(92% - (var(--lg-warp) * .25)% ) 110%,\n      rgba(110,185,255,.08),\n      transparent 46%\n    );\n  opacity: calc(.35 + (var(--lg-warp) * .006));\n  mix-blend-mode: screen;\n}\n\n/* Soft glass form fields \u2014 original */\nbody.theme-liquid-glass input,\nbody.theme-liquid-glass textarea,\nbody.theme-liquid-glass select {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    ) !important;\n  border-color: rgba(255,255,255,.16) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.09) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .48)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .48)) !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass input::placeholder,\nbody.theme-liquid-glass textarea::placeholder {\n  color: color-mix(in srgb, var(--text) 55%, transparent);\n  opacity: 1;\n}\n\nbody.theme-liquid-glass button {\n  transition:\n    background var(--anim),\n    border-color var(--anim),\n    box-shadow var(--anim),\n    transform var(--anim),\n    opacity var(--anim);\n}\n\n/* ============================================================\n   mpkg-compatible colour fixes\n   OS: .primary-btn { bg: var(--text); color: var(--win-bg) }\n   Light-theme fallbacks for anything not dark/obsidian/nova.\n   --win-bg is SOLID dark via theme vars; glass is visual-only.\n   ============================================================ */\n\nbody.theme-liquid-glass select,\nbody.theme-liquid-glass select option {\n  background-color: #2a2a2e !important;\n  color: #eee !important;\n  border-color: rgba(255,255,255,.16) !important;\n}\n\nbody.theme-liquid-glass .primary-btn {\n  background: var(--text) !important;\n  color: var(--win-bg) !important;\n  border: none !important;\n}\nbody.theme-liquid-glass .primary-btn:hover {\n  background: var(--accent, #9cc9ff) !important;\n  color: #0a0b0c !important;\n}\n\nbody.theme-liquid-glass,\nbody.theme-liquid-glass .window,\nbody.theme-liquid-glass .win-header,\nbody.theme-liquid-glass .win-content {\n  color: var(--text);\n}\n\nbody.theme-liquid-glass #taskbar,\nbody.theme-liquid-glass #start-menu,\nbody.theme-liquid-glass #quick-access,\nbody.theme-liquid-glass .context-menu,\nbody.theme-liquid-glass .mica-menu,\nbody.theme-liquid-glass .topbar-dd-menu {\n  color: var(--text);\n}\n\nbody.theme-liquid-glass #start-menu.open,\nbody.theme-liquid-glass #quick-access.open {\n  animation: mplgGlassIn 280ms cubic-bezier(.16,1,.3,1) both;\n}\n\n@keyframes mplgGlassIn {\n  from { opacity: 0; transform: translateY(8px) scale(.985); filter: blur(3px); }\n  to   { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }\n}\n\nbody.theme-liquid-glass .window.mplug-snap-anim,\n.window.mplug-snap-anim {\n  transition:\n    left 320ms cubic-bezier(.16, 1, .3, 1),\n    top 320ms cubic-bezier(.16, 1, .3, 1),\n    width 320ms cubic-bezier(.16, 1, .3, 1),\n    height 320ms cubic-bezier(.16, 1, .3, 1),\n    border-radius 280ms cubic-bezier(.16, 1, .3, 1) !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  body.theme-liquid-glass #start-menu.open,\n  body.theme-liquid-glass #quick-access.open {\n    animation: none !important;\n  }\n  body.theme-liquid-glass *,\n  body.theme-liquid-glass *::before,\n  body.theme-liquid-glass *::after {\n    transition-duration: 0.01ms !important;\n    animation-duration: 0.01ms !important;\n  }\n  .window.mplug-snap-anim {\n    transition: none !important;\n  }\n}\n`;\n  document.head.appendChild(style);\n}\n\nfunction applyGlassVars() {\n  const blur = num(STORAGE.blur, defaults.blur, 8, 52);\n  const warp = num(STORAGE.warp, defaults.warp, 0, 100);\n  const motion = num(STORAGE.motion, defaults.motion, 40, 220);\n\n  document.documentElement.style.setProperty('--mplug-lg-blur', blur + 'px');\n  document.documentElement.style.setProperty('--mplug-lg-warp', String(warp));\n  document.documentElement.style.setProperty('--mplug-lg-motion', motion + 'ms');\n\n  const body = document.body;\n  if (body) {\n    body.style.setProperty('--lg-blur', blur + 'px');\n    body.style.setProperty('--lg-warp', String(warp));\n    body.style.setProperty('--lg-motion', motion + 'ms');\n  }\n\n  return { blur, warp, motion };\n}\n\nasync function ensureLiquidTheme() {\n  if (typeof API === 'undefined' || !API.token || typeof API.themesSave !== 'function') return;\n\n  try {\n    const data = await API.themesList();\n    const themes = data.themes || [];\n    const existing = themes.find(t => t.id === 'theme-liquid-glass' || t.name === 'Liquid Glass');\n\n    /*\n     * mpkg-style semantic variables:\n     * --win-bg MUST be solid dark so OS rules like\n     *   .primary-btn { background: var(--text); color: var(--win-bg) }\n     * produce dark text on light buttons.\n     * Glass transparency is applied only by scoped CSS above.\n     */\n    const vars = [\n      '--bg:linear-gradient(135deg,#17202b 0%,#090b10 100%)',\n      '--win-bg:#1c1d22',\n      '--text:#f3f6fb',\n      '--input-bg:rgba(255,255,255,.055)',\n      '--dock-bg:rgba(20,20,24,.56)',\n      '--dock-border:rgba(255,255,255,.19)',\n      '--well-bg:rgba(255,255,255,.075)',\n      '--accent:#9cc9ff'\n    ].join(';');\n\n    const payload = {\n      id: 'theme-liquid-glass',\n      name: 'Liquid Glass',\n      cssClass: 'theme-liquid-glass',\n      cssVariables: vars,\n      bg: 'linear-gradient(135deg,#17202b 0%,#090b10 100%)',\n      text: '#f3f6fb'\n    };\n\n    // Always re-save so older broken registration is fixed\n    await API.themesSave(payload);\n\n    const activeCls = localStorage.getItem('mica_theme') || '';\n    if (activeCls === 'theme-liquid-glass' && typeof applyThemeObject === 'function') {\n      applyThemeObject(payload, true);\n    }\n  } catch (e) {\n    console.warn('[Liquid Glass] theme registration failed', e);\n  }\n}\n\nfunction installThemePickerRefresh() {\n  const observer = new MutationObserver(() => {\n    document.querySelectorAll('[id^=\"set_themes_\"]').forEach(el => {\n      if (el.dataset.lgPatched === '1') return;\n      const scan = el.textContent || '';\n      if (scan.includes('Liquid Glass')) el.dataset.lgPatched = '1';\n    });\n    patchAppearanceViews();\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n}\n\nfunction patchAppearanceViews() {\n  document.querySelectorAll('[id^=\"set_view_\"]').forEach(view => {\n    if (!(view.textContent || '').includes('Appearance')) return;\n    if (view.querySelector('.mplug-liquid-settings')) return;\n\n    const card = document.createElement('div');\n    card.className = 'mplug-liquid-settings';\n    card.innerHTML = `\n      <div style=\"\n        margin-top:16px;\n        padding:14px;\n        border:1px solid rgba(255,255,255,.13);\n        border-radius:14px;\n        background:rgba(255,255,255,.035);\n        box-shadow:inset 0 1px rgba(255,255,255,.08);\n      \">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;\">\n          <div>\n            <div style=\"font-size:14px;font-weight:700;\">\ud83e\udee7 Liquid Glass</div>\n            <div style=\"font-size:11px;opacity:.55;margin-top:3px;\">\n              Glass-only controls. Applied when the Liquid Glass system theme is selected.\n            </div>\n          </div>\n          <span style=\"font-size:10px;opacity:.5;\">THEME</span>\n        </div>\n        <div style=\"height:10px;\"></div>\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px;\">\n          <span>Blur</span>\n          <b id=\"mplug-lg-blur-value\">28px</b>\n        </label>\n        <input id=\"mplug-lg-blur\" type=\"range\" min=\"8\" max=\"52\" step=\"1\" style=\"width:100%;\">\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin:13px 0 5px;\">\n          <span>Warp / refraction</span>\n          <b id=\"mplug-lg-warp-value\">38%</b>\n        </label>\n        <input id=\"mplug-lg-warp\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" style=\"width:100%;\">\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin:13px 0 5px;\">\n          <span>Animation smoothness</span>\n          <b id=\"mplug-lg-motion-value\">100ms</b>\n        </label>\n        <input id=\"mplug-lg-motion\" type=\"range\" min=\"40\" max=\"220\" step=\"5\" style=\"width:100%;\">\n        <div style=\"display:flex;gap:7px;margin-top:13px;\">\n          <button type=\"button\" class=\"primary-btn\" id=\"mplug-lg-reset\" style=\"flex:1;padding:8px;\">\n            Reset\n          </button>\n        </div>\n      </div>\n    `;\n    view.appendChild(card);\n\n    const blur = card.querySelector('#mplug-lg-blur');\n    const warp = card.querySelector('#mplug-lg-warp');\n    const motion = card.querySelector('#mplug-lg-motion');\n    const bv = card.querySelector('#mplug-lg-blur-value');\n    const wv = card.querySelector('#mplug-lg-warp-value');\n    const mv = card.querySelector('#mplug-lg-motion-value');\n\n    function sync() {\n      const v = applyGlassVars();\n      blur.value = v.blur;\n      warp.value = v.warp;\n      motion.value = v.motion;\n      bv.textContent = v.blur + 'px';\n      wv.textContent = v.warp + '%';\n      mv.textContent = v.motion + 'ms';\n    }\n\n    blur.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.blur, blur.value);\n      sync();\n    });\n    warp.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.warp, warp.value);\n      sync();\n    });\n    motion.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.motion, motion.value);\n      sync();\n    });\n    card.querySelector('#mplug-lg-reset').addEventListener('click', () => {\n      localStorage.setItem(STORAGE.blur, defaults.blur);\n      localStorage.setItem(STORAGE.warp, defaults.warp);\n      localStorage.setItem(STORAGE.motion, defaults.motion);\n      sync();\n    });\n    sync();\n  });\n}\n\n/* ============================================================\n   WINDOWS 11-STYLE SNAP\n   ============================================================ */\n\nconst snapPreview = document.createElement('div');\nsnapPreview.id = 'mica-snap-preview';\nsnapPreview.style.cssText = `\n  position:fixed;\n  z-index:2147483000;\n  pointer-events:none;\n  display:none;\n  border:1px solid rgba(255,255,255,.44);\n  border-radius:14px;\n  background:\n    linear-gradient(135deg,rgba(255,255,255,.20),rgba(115,180,255,.08));\n  backdrop-filter:blur(16px) saturate(170%);\n  -webkit-backdrop-filter:blur(16px) saturate(170%);\n  box-shadow:0 14px 50px rgba(0,0,0,.22),inset 0 1px rgba(255,255,255,.28);\n  transition:\n    left 160ms cubic-bezier(.16,1,.3,1),\n    top 160ms cubic-bezier(.16,1,.3,1),\n    width 160ms cubic-bezier(.16,1,.3,1),\n    height 160ms cubic-bezier(.16,1,.3,1),\n    opacity 120ms ease;\n  opacity:0;\n`;\ndocument.body.appendChild(snapPreview);\n\nlet snapActive = null;\nlet snapZone = null;\nconst snapRestore = new WeakMap();\n\nfunction bounds() {\n  const tb = document.getElementById('taskbar');\n  const r = tb ? tb.getBoundingClientRect() : null;\n  let top = 8, bottom = 8, left = 8, right = 8;\n  if (tb && r && r.width > 0 && r.height > 0) {\n    if (document.body.classList.contains('tb-pos-top')) top = r.height + 8;\n    if (document.body.classList.contains('tb-pos-bottom')) bottom = r.height + 8;\n    if (document.body.classList.contains('tb-pos-left')) left = r.width + 8;\n    if (document.body.classList.contains('tb-pos-right')) right = r.width + 8;\n  }\n  const topbar = document.querySelector('.topbar, #topbar, .mica-topbar');\n  if (topbar) {\n    const tr = topbar.getBoundingClientRect();\n    if (tr.height > 0 && tr.top < 40) top = Math.max(top, tr.bottom + 4);\n  }\n  return {\n    x: left, y: top,\n    w: Math.max(320, window.innerWidth - left - right),\n    h: Math.max(220, window.innerHeight - top - bottom)\n  };\n}\n\nfunction snapZoneAt(x, y) {\n  const b = bounds();\n  const e = Math.max(32, Math.min(72, Math.min(b.w, b.h) * .05));\n  const c = Math.max(96, Math.min(160, b.h * .16));\n  if (x <= e && y <= c) return 'tl';\n  if (x >= window.innerWidth - e && y <= c) return 'tr';\n  if (x <= e && y >= window.innerHeight - c) return 'bl';\n  if (x >= window.innerWidth - e && y >= window.innerHeight - c) return 'br';\n  if (x <= e) return 'left';\n  if (x >= window.innerWidth - e) return 'right';\n  if (y <= e) return 'max';\n  return null;\n}\n\nfunction snapRect(z) {\n  const b = bounds();\n  const gap = 8;\n  const hw = Math.floor((b.w - gap) / 2);\n  const hh = Math.floor((b.h - gap) / 2);\n  return ({\n    left:  { left: b.x, top: b.y, width: hw, height: b.h },\n    right: { left: b.x+hw+gap, top: b.y, width: b.w-hw-gap, height: b.h },\n    tl:    { left: b.x, top: b.y, width: hw, height: hh },\n    tr:    { left: b.x+hw+gap, top: b.y, width: b.w-hw-gap, height: hh },\n    bl:    { left: b.x, top: b.y+hh+gap, width: hw, height: b.h-hh-gap },\n    br:    { left: b.x+hw+gap, top: b.y+hh+gap, width: b.w-hw-gap, height: b.h-hh-gap },\n    max:   { left: b.x, top: b.y, width: b.w, height: b.h }\n  })[z] || null;\n}\n\nfunction previewZone(z) {\n  const r = snapRect(z);\n  if (!r) {\n    snapPreview.style.opacity = '0';\n    setTimeout(() => { if (!snapZone) snapPreview.style.display = 'none'; }, 140);\n    return;\n  }\n  Object.assign(snapPreview.style, {\n    display: 'block',\n    left: r.left+'px', top: r.top+'px',\n    width: r.width+'px', height: r.height+'px',\n    opacity: '1'\n  });\n}\n\nfunction storeRestore(el) {\n  if (snapRestore.has(el)) return;\n  snapRestore.set(el, {\n    left: el.style.left || el.offsetLeft + 'px',\n    top: el.style.top || el.offsetTop + 'px',\n    width: el.style.width || el.offsetWidth + 'px',\n    height: el.style.height || el.offsetHeight + 'px',\n    right: el.style.right || '',\n    bottom: el.style.bottom || '',\n    borderRadius: el.style.borderRadius || '',\n    wasMaximized: el.classList.contains('maximized')\n  });\n}\n\nfunction animateTo(el, styles, durationMs = 320) {\n  el.classList.add('mplug-snap-anim');\n  void el.offsetWidth;\n  Object.assign(el.style, styles);\n  clearTimeout(el._mplugSnapT);\n  el._mplugSnapT = setTimeout(() => el.classList.remove('mplug-snap-anim'), durationMs + 40);\n}\n\nfunction snapWindow(el, z) {\n  if (!el) return;\n  if (z === 'max') {\n    storeRestore(el);\n    el.dataset.micaSnap = 'max';\n    if (typeof App !== 'undefined' && App.toggleMaximize) {\n      if (!el.classList.contains('maximized')) {\n        el.dataset.oldLeft = el.style.left || el.offsetLeft + 'px';\n        el.dataset.oldTop = el.style.top || el.offsetTop + 'px';\n        el.dataset.oldWidth = el.style.width || el.offsetWidth + 'px';\n        el.dataset.oldHeight = el.style.height || el.offsetHeight + 'px';\n        if (App.layoutWindowMax) {\n          el.classList.add('mplug-snap-anim');\n          void el.offsetWidth;\n          App.layoutWindowMax(el);\n          setTimeout(() => el.classList.remove('mplug-snap-anim'), 340);\n        } else {\n          App.toggleMaximize(el.id);\n        }\n      }\n    } else {\n      const r = snapRect('max');\n      if (!r) return;\n      animateTo(el, {\n        left: r.left+'px', top: r.top+'px',\n        width: r.width+'px', height: r.height+'px',\n        right: 'auto', bottom: 'auto', borderRadius: '0'\n      });\n      el.classList.add('maximized');\n    }\n    return;\n  }\n  const r = snapRect(z);\n  if (!r) return;\n  storeRestore(el);\n  if (el.classList.contains('maximized')) {\n    el.classList.remove('maximized', 'dock-fill', 'true-fullscreen');\n    el.style.borderRadius = '';\n  }\n  el.dataset.micaSnap = z;\n  animateTo(el, {\n    left: r.left+'px', top: r.top+'px',\n    width: r.width+'px', height: r.height+'px',\n    right: 'auto', bottom: 'auto', borderRadius: ''\n  });\n}\n\nfunction unsnap(el, animate = true) {\n  if (!el) return;\n  const p = snapRestore.get(el);\n  if (!p) {\n    el.dataset.micaSnap = '';\n    if (el.classList.contains('maximized') && typeof App !== 'undefined' && App.toggleMaximize) {\n      App.toggleMaximize(el.id);\n    }\n    return;\n  }\n  el.dataset.micaSnap = '';\n  el.classList.remove('maximized', 'dock-fill', 'true-fullscreen');\n  const styles = {\n    left: p.left, top: p.top,\n    width: p.width, height: p.height,\n    right: p.right || 'auto', bottom: p.bottom || 'auto',\n    borderRadius: p.borderRadius || ''\n  };\n  if (animate) animateTo(el, styles);\n  else Object.assign(el.style, styles);\n  snapRestore.delete(el);\n}\n\nfunction isWindowHeader(e) {\n  const h = e.target.closest('.win-header');\n  if (!h) return false;\n  if (e.target.closest('.win-controls, button, input, textarea, select, a')) return false;\n  return true;\n}\n\nfunction isSnapped(el) {\n  return !!(el && (el.dataset.micaSnap || el.classList.contains('maximized')));\n}\n\ndocument.addEventListener('pointerdown', e => {\n  const el = e.target.closest('.window');\n  if (!el || !isWindowHeader(e)) return;\n  if (el.dataset.fs === '1' || el.classList.contains('true-fullscreen')) return;\n  if (isSnapped(el)) {\n    if (el.classList.contains('maximized') && !snapRestore.has(el)) storeRestore(el);\n    unsnap(el, false);\n  }\n  snapActive = { el, startX: e.clientX, startY: e.clientY };\n  snapZone = null;\n}, true);\n\ndocument.addEventListener('pointermove', e => {\n  if (!snapActive) return;\n  const dx = Math.abs(e.clientX - snapActive.startX);\n  const dy = Math.abs(e.clientY - snapActive.startY);\n  if (dx < 4 && dy < 4) return;\n  const z = snapZoneAt(e.clientX, e.clientY);\n  if (z !== snapZone) {\n    snapZone = z;\n    previewZone(z);\n  }\n}, true);\n\ndocument.addEventListener('pointerup', () => {\n  if (!snapActive) return;\n  if (snapZone) snapWindow(snapActive.el, snapZone);\n  snapPreview.style.opacity = '0';\n  setTimeout(() => { snapPreview.style.display = 'none'; }, 160);\n  snapActive = null;\n  snapZone = null;\n}, true);\n\ndocument.addEventListener('pointercancel', () => {\n  snapPreview.style.opacity = '0';\n  snapPreview.style.display = 'none';\n  snapActive = null;\n  snapZone = null;\n}, true);\n\nwindow.addEventListener('keydown', e => {\n  if (!e.altKey || e.ctrlKey || e.metaKey) return;\n  const el =\n    document.querySelector('.window:hover') ||\n    [...document.querySelectorAll('.window')].sort(\n      (a, b) => (+b.style.zIndex || 0) - (+a.style.zIndex || 0)\n    )[0];\n  if (!el || el.dataset.fs === '1' || el.classList.contains('true-fullscreen')) return;\n  let z = null;\n  if (e.key === 'ArrowLeft')  z = 'left';\n  if (e.key === 'ArrowRight') z = 'right';\n  if (e.key === 'ArrowUp')    z = 'max';\n  if (e.key === 'ArrowDown') {\n    if (isSnapped(el)) {\n      unsnap(el, true);\n      e.preventDefault();\n    }\n    return;\n  }\n  if (z) {\n    snapWindow(el, z);\n    e.preventDefault();\n  }\n});\n\nwindow.addEventListener('resize', () => {\n  document.querySelectorAll('.window[data-mica-snap]').forEach(el => {\n    const z = el.dataset.micaSnap;\n    if (z && z !== 'max') snapWindow(el, z);\n    else if (z === 'max' && el.classList.contains('maximized') && typeof App !== 'undefined' && App.layoutWindowMax) {\n      App.layoutWindowMax(el);\n    }\n  });\n});\n\nasync function boot() {\n  ensureCSS();\n  applyGlassVars();\n  installThemePickerRefresh();\n  patchAppearanceViews();\n  await ensureLiquidTheme();\n}\n\nboot();\n\nconsole.log('[Mica Plugin] Liquid Glass Theme + Snap v2.2.0 loaded');\n})();\n"
}