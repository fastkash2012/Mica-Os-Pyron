{
  "id": "liquid-glass-theme",
  "name": "Liquid Glass Theme",
  "version": "3.4.0",
  "description": "Liquid Glass theme-only. Bubble buttons restored to liquid glass. Control Centre glass in all modes. Seamless UI polish.",
  "kind": "mplug",
  "hooks": [
    "boot"
  ],
  "js": "(() => {\n'use strict';\n\n/*\n * Mica OS Pyron \u2014 Liquid Glass Theme\n * v3.4.0  (theme-only)\n *\n * \u2022 Bubble buttons: liquid glass again (subtle in topbar strip)\n * \u2022 Control Centre / QA: full liquid glass in all modes\n * \u2022 Seamless UI polish\n */\n\nconst STYLE_ID = 'mplug-liquid-glass-theme-style';\nconst FIX_STYLE_ID = 'mplug-liquid-glass-runtime-fix';\n\nconst STORAGE = {\n  blur: 'mplug_lg_blur',\n  warp: 'mplug_lg_warp',\n  motion: 'mplug_lg_motion'\n};\n\nconst defaults = { blur: 28, warp: 38, motion: 100 };\n\nfunction num(key, fallback, min, max) {\n  const v = Number(localStorage.getItem(key));\n  return Number.isFinite(v) ? Math.max(min, Math.min(max, v)) : fallback;\n}\n\nfunction isLiquidActive() {\n  return document.body && document.body.classList.contains('theme-liquid-glass');\n}\n\nfunction ensureCSS() {\n  if (document.getElementById(STYLE_ID)) return;\n\n  const style = document.createElement('style');\n  style.id = STYLE_ID;\n  style.textContent = `\n/* ============================================================\n   LIQUID GLASS THEME v3.4 \u2014 seamless\n   ============================================================ */\n\nbody.theme-liquid-glass {\n  --lg-blur: ${defaults.blur}px;\n  --lg-warp: ${defaults.warp};\n  --lg-motion: ${defaults.motion}ms;\n\n  --lg-border: rgba(255,255,255,0.19);\n  --lg-border-strong: rgba(255,255,255,0.28);\n  --lg-shadow:\n    0 18px 55px rgba(0,0,0,.25),\n    0 5px 18px rgba(0,0,0,.14),\n    inset 0 1px 0 rgba(255,255,255,.20);\n  --lg-shadow-small:\n    0 10px 28px rgba(0,0,0,.18),\n    inset 0 1px 0 rgba(255,255,255,.14);\n\n  --anim: cubic-bezier(.16,1,.3,1) var(--lg-motion);\n  --blur: blur(var(--lg-blur)) saturate(175%);\n  --dock-bg: rgba(20,20,24,.56);\n  --dock-border: var(--lg-border);\n  --input-bg: rgba(255,255,255,.055);\n  --well-bg: rgba(255,255,255,.075);\n}\n\n/* \u2500\u2500 Shared glass fill \u2500\u2500 */\nbody.theme-liquid-glass #taskbar,\nbody.theme-liquid-glass #start-menu,\nbody.theme-liquid-glass #quick-access,\nbody.theme-liquid-glass .tv-panel,\nbody.theme-liquid-glass .mica-modal-card,\nbody.theme-liquid-glass .sw-card,\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar) {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.12) 0%,\n      rgba(255,255,255,.035) 48%,\n      rgba(255,255,255,.085) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n  color: var(--text) !important;\n}\n\n/* QA drop mode \u2014 beat OS white fallback with same glass */\nbody.theme-liquid-glass #quick-access.qa-mode-drop,\nbody.theme-liquid-glass #quick-access.qa-mode-action,\nbody.theme-liquid-glass #quick-access.qa-mode-task {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.12) 0%,\n      rgba(255,255,255,.035) 48%,\n      rgba(255,255,255,.085) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass .qa-cc-card,\nbody.theme-liquid-glass .qa-cc-section,\nbody.theme-liquid-glass .qa-settings-card {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.08),\n      rgba(255,255,255,.03)\n    ) !important;\n  border: 1px solid rgba(255,255,255,.11) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.08) !important;\n  color: var(--text) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .5)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .5)) !important;\n}\n\nbody.theme-liquid-glass .qa-cc-card:not(.qa-cc-wide):hover {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.14),\n      rgba(255,255,255,.05)\n    ) !important;\n  border-color: rgba(255,255,255,.16) !important;\n}\n\n/* \u2500\u2500 Windows \u2500\u2500 */\nbody.theme-liquid-glass .window {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.105) 0%,\n      rgba(255,255,255,.028) 52%,\n      rgba(255,255,255,.075) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n}\n\nbody.theme-liquid-glass .win-header,\nbody.theme-liquid-glass .jade-toolbar,\nbody.theme-liquid-glass .studio-menubar,\nbody.theme-liquid-glass .studio-toolbar {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.10),\n      rgba(255,255,255,.028)\n    ) !important;\n  border-color: rgba(255,255,255,.13) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .68)) saturate(165%) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .68)) saturate(165%) !important;\n}\n\nbody.theme-liquid-glass .win-content,\nbody.theme-liquid-glass .jade-sidebar,\nbody.theme-liquid-glass .sm-body,\nbody.theme-liquid-glass .sm-main {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.018),\n      rgba(255,255,255,.005)\n    ) !important;\n}\n\nbody.theme-liquid-glass .jade-sidebar,\nbody.theme-liquid-glass .sm-side {\n  background: rgba(255,255,255,.035) !important;\n  border-color: rgba(255,255,255,.12) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .60)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .60)) !important;\n}\n\n/* \u2500\u2500 Interactive surfaces + bubble buttons (floating) \u2500\u2500 */\nbody.theme-liquid-glass .bubble-btn,\nbody.theme-liquid-glass .tb-start-btn,\nbody.theme-liquid-glass .tb-app-btn,\nbody.theme-liquid-glass .sm-tile,\nbody.theme-liquid-glass .sm-list-item,\nbody.theme-liquid-glass .sm-app,\nbody.theme-liquid-glass .sm-search,\nbody.theme-liquid-glass .sm-side button,\nbody.theme-liquid-glass .qa-chip,\nbody.theme-liquid-glass .qa-st,\nbody.theme-liquid-glass .qa-tile,\nbody.theme-liquid-glass .qa-slider-block,\nbody.theme-liquid-glass .qa-slider-row,\nbody.theme-liquid-glass .wp-preset-card,\nbody.theme-liquid-glass .store-item,\nbody.theme-liquid-glass .tb-instance-card {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    ) !important;\n  border: 1px solid rgba(255,255,255,.13) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.09) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .58)) saturate(155%) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .58)) saturate(155%) !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass .bubble-btn,\nbody.theme-liquid-glass .tb-start-btn,\nbody.theme-liquid-glass .tb-app-btn,\nbody.theme-liquid-glass .sm-tile,\nbody.theme-liquid-glass .sm-list-item,\nbody.theme-liquid-glass .sm-app,\nbody.theme-liquid-glass .qa-chip,\nbody.theme-liquid-glass .qa-tile,\nbody.theme-liquid-glass .wp-preset-card {\n  transition:\n    background var(--anim),\n    border-color var(--anim),\n    box-shadow var(--anim),\n    transform var(--anim),\n    opacity var(--anim);\n}\n\nbody.theme-liquid-glass .bubble-btn:hover,\nbody.theme-liquid-glass .tb-start-btn:hover,\nbody.theme-liquid-glass .tb-app-btn:hover,\nbody.theme-liquid-glass .sm-tile:hover,\nbody.theme-liquid-glass .sm-list-item:hover,\nbody.theme-liquid-glass .sm-app:hover,\nbody.theme-liquid-glass .qa-chip:hover,\nbody.theme-liquid-glass .qa-tile:hover,\nbody.theme-liquid-glass .wp-preset-card:hover {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.16),\n      rgba(255,255,255,.045)\n    ) !important;\n  border-color: var(--lg-border-strong) !important;\n  box-shadow:\n    0 8px 24px rgba(0,0,0,.11),\n    inset 0 1px 0 rgba(255,255,255,.19) !important;\n}\n\n/* Topbar mode: keep bubble buttons light glass chips, not solid black */\nbody.theme-liquid-glass.bubble-pin-topbar #vertical-bubble.pin-topbar .bubble-btn {\n  background: rgba(255,255,255,0.08) !important;\n  border: 1px solid rgba(255,255,255,0.12) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.10) !important;\n  backdrop-filter: blur(12px) !important;\n  -webkit-backdrop-filter: blur(12px) !important;\n  color: var(--text) !important;\n}\nbody.theme-liquid-glass.bubble-pin-topbar #vertical-bubble.pin-topbar .bubble-btn:hover {\n  background: rgba(255,255,255,0.16) !important;\n  border-color: rgba(255,255,255,0.20) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.14) !important;\n}\n\n/* Liquid highlight */\nbody.theme-liquid-glass #start-menu::after,\nbody.theme-liquid-glass #quick-access::after,\nbody.theme-liquid-glass .window::after,\nbody.theme-liquid-glass .mica-modal-card::after,\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  border-radius: inherit;\n  background:\n    radial-gradient(\n      115% 70% at calc(15% + (var(--lg-warp) * .55)% ) -8%,\n      rgba(255,255,255,.18),\n      transparent 42%\n    ),\n    radial-gradient(\n      80% 90% at calc(92% - (var(--lg-warp) * .25)% ) 110%,\n      rgba(110,185,255,.08),\n      transparent 46%\n    );\n  opacity: calc(.35 + (var(--lg-warp) * .006));\n  mix-blend-mode: screen;\n}\n\nbody.theme-liquid-glass.bubble-pin-topbar #vertical-bubble.pin-topbar::after {\n  content: none !important;\n  display: none !important;\n}\n\n/* Forms */\nbody.theme-liquid-glass input,\nbody.theme-liquid-glass textarea,\nbody.theme-liquid-glass select {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    ) !important;\n  border-color: rgba(255,255,255,.16) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.09) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .48)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .48)) !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass input::placeholder,\nbody.theme-liquid-glass textarea::placeholder {\n  color: color-mix(in srgb, var(--text) 55%, transparent);\n  opacity: 1;\n}\n\nbody.theme-liquid-glass button {\n  transition:\n    background var(--anim),\n    border-color var(--anim),\n    box-shadow var(--anim),\n    transform var(--anim),\n    opacity var(--anim);\n}\n\n/* Menus \u2014 seamless with glass */\nbody.theme-liquid-glass .topbar-dd-menu,\nbody.theme-liquid-glass .studio-dd-menu,\nbody.theme-liquid-glass .mica-ctx,\nbody.theme-liquid-glass .context-menu,\nbody.theme-liquid-glass .mica-menu {\n  background:\n    linear-gradient(\n      160deg,\n      rgba(255,255,255,.10) 0%,\n      rgba(22, 24, 30, 0.90) 45%,\n      rgba(18, 20, 26, 0.94) 100%\n    ) !important;\n  border: 1px solid rgba(255,255,255,0.14) !important;\n  border-radius: 12px !important;\n  box-shadow:\n    0 16px 40px rgba(0,0,0,0.38),\n    inset 0 1px 0 rgba(255,255,255,0.12) !important;\n  backdrop-filter: blur(22px) saturate(165%) !important;\n  -webkit-backdrop-filter: blur(22px) saturate(165%) !important;\n  padding: 6px !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass .topbar-dd-item,\nbody.theme-liquid-glass .context-item,\nbody.theme-liquid-glass .mica-ctx .context-item {\n  border-radius: 8px !important;\n  padding: 8px 12px !important;\n  margin: 0 2px !important;\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass .topbar-dd-item:hover,\nbody.theme-liquid-glass .context-item:hover,\nbody.theme-liquid-glass .mica-ctx .context-item:hover {\n  background: rgba(255,255,255,0.10) !important;\n}\n\n/* MicaTasking */\nbody.theme-liquid-glass .mc-under-app {\n  background: rgba(255,255,255,0.05) !important;\n  border: 1px solid transparent !important;\n  box-shadow: none !important;\n  color: rgba(243,246,251,0.92) !important;\n  border-radius: 8px !important;\n  transition: background 140ms ease, border-color 140ms ease;\n}\nbody.theme-liquid-glass .mc-under-app:hover {\n  background: rgba(255,255,255,0.10) !important;\n  border-color: rgba(255,255,255,0.08) !important;\n}\n\nbody.theme-liquid-glass .mc-preview {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.08),\n      rgba(20,22,28,.85)\n    ) !important;\n  border: 1px solid rgba(255,255,255,0.12) !important;\n}\n\nbody.theme-liquid-glass .mc-dock button {\n  background: rgba(255,255,255,0.10) !important;\n  border: 1px solid rgba(255,255,255,0.14) !important;\n  color: var(--text) !important;\n  border-radius: 10px !important;\n}\nbody.theme-liquid-glass .mc-dock button:hover {\n  background: rgba(255,255,255,0.18) !important;\n}\n\n/* Colour helpers */\nbody.theme-liquid-glass select,\nbody.theme-liquid-glass select option {\n  background-color: #2a2a2e !important;\n  color: #eee !important;\n}\n\nbody.theme-liquid-glass .primary-btn {\n  background: var(--text) !important;\n  color: var(--win-bg) !important;\n  border: none !important;\n}\nbody.theme-liquid-glass .primary-btn:hover {\n  background: var(--accent, #9cc9ff) !important;\n  color: #0a0b0c !important;\n}\n\nbody.theme-liquid-glass,\nbody.theme-liquid-glass .window,\nbody.theme-liquid-glass .win-header,\nbody.theme-liquid-glass .win-content {\n  color: var(--text);\n}\n\nbody.theme-liquid-glass #start-menu.open,\nbody.theme-liquid-glass #quick-access.open {\n  animation: mplgGlassIn 280ms cubic-bezier(.16,1,.3,1) both;\n}\n\n@keyframes mplgGlassIn {\n  from { opacity: 0; transform: translateY(8px) scale(.985); filter: blur(3px); }\n  to   { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  body.theme-liquid-glass #start-menu.open,\n  body.theme-liquid-glass #quick-access.open {\n    animation: none !important;\n  }\n}\n`;\n  document.head.appendChild(style);\n}\n\nfunction applyGlassVars() {\n  const blur = num(STORAGE.blur, defaults.blur, 8, 52);\n  const warp = num(STORAGE.warp, defaults.warp, 0, 100);\n  const motion = num(STORAGE.motion, defaults.motion, 40, 220);\n\n  document.documentElement.style.setProperty('--mplug-lg-blur', blur + 'px');\n  document.documentElement.style.setProperty('--mplug-lg-warp', String(warp));\n  document.documentElement.style.setProperty('--mplug-lg-motion', motion + 'ms');\n\n  if (document.body) {\n    document.body.style.setProperty('--lg-blur', blur + 'px');\n    document.body.style.setProperty('--lg-warp', String(warp));\n    document.body.style.setProperty('--lg-motion', motion + 'ms');\n  }\n  return { blur, warp, motion };\n}\n\nfunction liquidGlassBg() {\n  return 'linear-gradient(135deg, rgba(255,255,255,.12) 0%, rgba(255,255,255,.035) 48%, rgba(255,255,255,.085) 100%)';\n}\n\nfunction fixControlCentrePanel(qa) {\n  if (!qa || !isLiquidActive()) return;\n\n  const text = getComputedStyle(document.body).getPropertyValue('--text').trim() || '#f3f6fb';\n  const blur = getComputedStyle(document.body).getPropertyValue('--lg-blur').trim() || '28px';\n\n  qa.style.setProperty('background', liquidGlassBg(), 'important');\n  qa.style.setProperty('color', text, 'important');\n  qa.style.setProperty('border', '1px solid rgba(255,255,255,0.19)', 'important');\n  qa.style.setProperty('box-shadow', '0 18px 55px rgba(0,0,0,.25), 0 5px 18px rgba(0,0,0,.14), inset 0 1px 0 rgba(255,255,255,.20)', 'important');\n  qa.style.setProperty('backdrop-filter', 'blur(' + blur + ') saturate(175%)', 'important');\n  qa.style.setProperty('-webkit-backdrop-filter', 'blur(' + blur + ') saturate(175%)', 'important');\n\n  qa.querySelectorAll('.qa-cc-card, .qa-cc-section').forEach(el => {\n    el.style.setProperty('background', 'linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.03))', 'important');\n    el.style.setProperty('color', text, 'important');\n    el.style.setProperty('border', '1px solid rgba(255,255,255,0.11)', 'important');\n    el.style.setProperty('box-shadow', 'inset 0 1px 0 rgba(255,255,255,0.08)', 'important');\n  });\n}\n\nfunction fixTopbarBubble() {\n  if (!isLiquidActive()) return;\n  const bubble = document.getElementById('vertical-bubble');\n  if (!bubble) return;\n\n  if (bubble.classList.contains('pin-topbar') || document.body.classList.contains('bubble-pin-topbar')) {\n    bubble.style.setProperty('background', 'rgba(28, 28, 30, 0.72)', 'important');\n    bubble.style.setProperty('backdrop-filter', 'blur(40px) saturate(1.6)', 'important');\n    bubble.style.setProperty('-webkit-backdrop-filter', 'blur(40px) saturate(1.6)', 'important');\n    bubble.style.setProperty('border', 'none', 'important');\n    bubble.style.setProperty('border-bottom', '1px solid rgba(255,255,255,0.1)', 'important');\n    bubble.style.setProperty('box-shadow', 'none', 'important');\n    bubble.style.setProperty('border-radius', '0', 'important');\n\n    // topbar text chrome only\n    bubble.querySelectorAll('.topbar-menu-item, .topbar-status, .topbar-clock, .topbar-brand, .topbar-pin-btn, .topbar-slot').forEach(el => {\n      el.style.setProperty('background', 'transparent', 'important');\n      el.style.setProperty('box-shadow', 'none', 'important');\n      el.style.setProperty('border', 'none', 'important');\n      el.style.setProperty('backdrop-filter', 'none', 'important');\n      el.style.setProperty('-webkit-backdrop-filter', 'none', 'important');\n      el.style.setProperty('color', 'var(--text, #f3f6fb)', 'important');\n    });\n\n    // bubble buttons: light glass chips (CSS also covers this; reinforce)\n    bubble.querySelectorAll('.bubble-btn').forEach(el => {\n      el.style.setProperty('background', 'rgba(255,255,255,0.08)', 'important');\n      el.style.setProperty('border', '1px solid rgba(255,255,255,0.12)', 'important');\n      el.style.setProperty('box-shadow', 'inset 0 1px 0 rgba(255,255,255,0.10)', 'important');\n      el.style.setProperty('backdrop-filter', 'blur(12px)', 'important');\n      el.style.setProperty('-webkit-backdrop-filter', 'blur(12px)', 'important');\n      el.style.setProperty('color', 'var(--text, #f3f6fb)', 'important');\n    });\n  } else {\n    ['background', 'backdrop-filter', '-webkit-backdrop-filter', 'border', 'border-bottom', 'box-shadow', 'border-radius'].forEach(p => {\n      bubble.style.removeProperty(p);\n    });\n    // clear topbar-only inline on buttons so CSS glass applies\n    bubble.querySelectorAll('.bubble-btn').forEach(el => {\n      ['background', 'border', 'box-shadow', 'backdrop-filter', '-webkit-backdrop-filter', 'color'].forEach(p => {\n        el.style.removeProperty(p);\n      });\n    });\n  }\n}\n\nfunction installRuntimeFixes() {\n  if (!document.getElementById(FIX_STYLE_ID)) {\n    document.head.appendChild(Object.assign(document.createElement('style'), { id: FIX_STYLE_ID }));\n  }\n\n  const run = () => {\n    if (!isLiquidActive()) return;\n    fixTopbarBubble();\n    const qa = document.getElementById('quick-access');\n    if (qa) fixControlCentrePanel(qa);\n  };\n\n  run();\n\n  new MutationObserver(() => { run(); }).observe(document.body, {\n    attributes: true,\n    attributeFilter: ['class'],\n    childList: true,\n    subtree: true\n  });\n\n  document.addEventListener('click', () => setTimeout(run, 30), true);\n}\n\nasync function ensureLiquidTheme() {\n  if (typeof API === 'undefined' || !API.token || typeof API.themesSave !== 'function') return;\n\n  try {\n    const vars = [\n      '--bg:linear-gradient(135deg,#17202b 0%,#090b10 100%)',\n      '--win-bg:#1c1d22',\n      '--text:#f3f6fb',\n      '--input-bg:rgba(255,255,255,.055)',\n      '--dock-bg:rgba(20,20,24,.56)',\n      '--dock-border:rgba(255,255,255,.19)',\n      '--well-bg:rgba(255,255,255,.075)',\n      '--accent:#9cc9ff'\n    ].join(';');\n\n    const payload = {\n      id: 'theme-liquid-glass',\n      name: 'Liquid Glass',\n      cssClass: 'theme-liquid-glass',\n      cssVariables: vars,\n      bg: 'linear-gradient(135deg,#17202b 0%,#090b10 100%)',\n      text: '#f3f6fb'\n    };\n\n    await API.themesSave(payload);\n\n    const activeCls = localStorage.getItem('mica_theme') || '';\n    if (activeCls === 'theme-liquid-glass' && typeof applyThemeObject === 'function') {\n      applyThemeObject(payload, true);\n    }\n  } catch (e) {\n    console.warn('[Liquid Glass] theme registration failed', e);\n  }\n}\n\nfunction installThemePickerRefresh() {\n  new MutationObserver(() => {\n    document.querySelectorAll('[id^=\"set_themes_\"]').forEach(el => {\n      if (el.dataset.lgPatched === '1') return;\n      if ((el.textContent || '').includes('Liquid Glass')) el.dataset.lgPatched = '1';\n    });\n    patchAppearanceViews();\n  }).observe(document.body, { childList: true, subtree: true });\n}\n\nfunction patchAppearanceViews() {\n  document.querySelectorAll('[id^=\"set_view_\"]').forEach(view => {\n    if (!(view.textContent || '').includes('Appearance')) return;\n    if (view.querySelector('.mplug-liquid-settings')) return;\n\n    const card = document.createElement('div');\n    card.className = 'mplug-liquid-settings';\n    card.innerHTML = `\n      <div style=\"\n        margin-top:16px;padding:14px;\n        border:1px solid rgba(255,255,255,.13);border-radius:14px;\n        background:rgba(255,255,255,.035);\n        box-shadow:inset 0 1px rgba(255,255,255,.08);\n      \">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;\">\n          <div>\n            <div style=\"font-size:14px;font-weight:700;\">\ud83e\udee7 Liquid Glass</div>\n            <div style=\"font-size:11px;opacity:.55;margin-top:3px;\">\n              Glass-only controls. Applied when the Liquid Glass system theme is selected.\n            </div>\n          </div>\n          <span style=\"font-size:10px;opacity:.5;\">THEME</span>\n        </div>\n        <div style=\"height:10px;\"></div>\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px;\">\n          <span>Blur</span>\n          <b id=\"mplug-lg-blur-value\">28px</b>\n        </label>\n        <input id=\"mplug-lg-blur\" type=\"range\" min=\"8\" max=\"52\" step=\"1\" style=\"width:100%;\">\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin:13px 0 5px;\">\n          <span>Warp / refraction</span>\n          <b id=\"mplug-lg-warp-value\">38%</b>\n        </label>\n        <input id=\"mplug-lg-warp\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" style=\"width:100%;\">\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin:13px 0 5px;\">\n          <span>Animation smoothness</span>\n          <b id=\"mplug-lg-motion-value\">100ms</b>\n        </label>\n        <input id=\"mplug-lg-motion\" type=\"range\" min=\"40\" max=\"220\" step=\"5\" style=\"width:100%;\">\n        <div style=\"display:flex;gap:7px;margin-top:13px;\">\n          <button type=\"button\" class=\"primary-btn\" id=\"mplug-lg-reset\" style=\"flex:1;padding:8px;\">Reset</button>\n        </div>\n      </div>\n    `;\n    view.appendChild(card);\n\n    const blur = card.querySelector('#mplug-lg-blur');\n    const warp = card.querySelector('#mplug-lg-warp');\n    const motion = card.querySelector('#mplug-lg-motion');\n    const bv = card.querySelector('#mplug-lg-blur-value');\n    const wv = card.querySelector('#mplug-lg-warp-value');\n    const mv = card.querySelector('#mplug-lg-motion-value');\n\n    function sync() {\n      const v = applyGlassVars();\n      blur.value = v.blur;\n      warp.value = v.warp;\n      motion.value = v.motion;\n      bv.textContent = v.blur + 'px';\n      wv.textContent = v.warp + '%';\n      mv.textContent = v.motion + 'ms';\n    }\n\n    blur.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.blur, blur.value);\n      sync();\n    });\n    warp.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.warp, warp.value);\n      sync();\n    });\n    motion.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.motion, motion.value);\n      sync();\n    });\n    card.querySelector('#mplug-lg-reset').addEventListener('click', () => {\n      localStorage.setItem(STORAGE.blur, defaults.blur);\n      localStorage.setItem(STORAGE.warp, defaults.warp);\n      localStorage.setItem(STORAGE.motion, defaults.motion);\n      sync();\n    });\n    sync();\n  });\n}\n\nasync function boot() {\n  ensureCSS();\n  applyGlassVars();\n  installThemePickerRefresh();\n  patchAppearanceViews();\n  installRuntimeFixes();\n  await ensureLiquidTheme();\n  setTimeout(() => {\n    const qa = document.getElementById('quick-access');\n    if (qa) fixControlCentrePanel(qa);\n    fixTopbarBubble();\n  }, 400);\n}\n\nboot();\nconsole.log('[Mica Plugin] Liquid Glass Theme v3.4.0 loaded');\n})();\n"
}