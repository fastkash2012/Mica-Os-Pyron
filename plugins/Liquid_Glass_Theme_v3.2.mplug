{
  "id": "liquid-glass-theme",
  "name": "Liquid Glass Theme",
  "version": "3.2.0",
  "description": "Liquid Glass theme-only plugin. Original glass look restored. Topbar and Control Centre fixed via runtime JS, not heavy CSS overrides.",
  "kind": "mplug",
  "hooks": [
    "boot"
  ],
  "js": "(() => {\n'use strict';\n\n/*\n * Mica OS Pyron \u2014 Liquid Glass Theme\n * v3.2.0  (theme-only)\n *\n * \u2022 Original glass look (rolled back from v3.1 dark QA over-styles)\n * \u2022 Topbar / Control Centre fixed in JS (not by painting every panel black)\n * \u2022 MicaTasking under-list slightly softened\n */\n\nconst STYLE_ID = 'mplug-liquid-glass-theme-style';\nconst FIX_STYLE_ID = 'mplug-liquid-glass-runtime-fix';\n\nconst STORAGE = {\n  blur: 'mplug_lg_blur',\n  warp: 'mplug_lg_warp',\n  motion: 'mplug_lg_motion'\n};\n\nconst defaults = { blur: 28, warp: 38, motion: 100 };\n\nfunction num(key, fallback, min, max) {\n  const v = Number(localStorage.getItem(key));\n  return Number.isFinite(v) ? Math.max(min, Math.min(max, v)) : fallback;\n}\n\nfunction isLiquidActive() {\n  return document.body && document.body.classList.contains('theme-liquid-glass');\n}\n\nfunction ensureCSS() {\n  if (document.getElementById(STYLE_ID)) return;\n\n  const style = document.createElement('style');\n  style.id = STYLE_ID;\n  style.textContent = `\n/* ============================================================\n   LIQUID GLASS THEME \u2014 original visual style\n   ============================================================ */\n\nbody.theme-liquid-glass {\n  --lg-blur: ${defaults.blur}px;\n  --lg-warp: ${defaults.warp};\n  --lg-motion: ${defaults.motion}ms;\n\n  --lg-border: rgba(255,255,255,0.19);\n  --lg-border-strong: rgba(255,255,255,0.28);\n  --lg-shadow:\n    0 18px 55px rgba(0,0,0,.25),\n    0 5px 18px rgba(0,0,0,.14),\n    inset 0 1px 0 rgba(255,255,255,.20);\n\n  --anim: cubic-bezier(.16,1,.3,1) var(--lg-motion);\n  --blur: blur(var(--lg-blur)) saturate(175%);\n  --dock-bg: rgba(20,20,24,.56);\n  --dock-border: var(--lg-border);\n  --input-bg: rgba(255,255,255,.055);\n  --well-bg: rgba(255,255,255,.075);\n}\n\n/* Shell \u2014 taskbar, start, floating bubble only (not pin-topbar) */\nbody.theme-liquid-glass #taskbar,\nbody.theme-liquid-glass #start-menu,\nbody.theme-liquid-glass .tv-panel,\nbody.theme-liquid-glass .mica-modal-card,\nbody.theme-liquid-glass .sw-card {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.12) 0%,\n      rgba(255,255,255,.035) 48%,\n      rgba(255,255,255,.085) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n}\n\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar) {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.12) 0%,\n      rgba(255,255,255,.035) 48%,\n      rgba(255,255,255,.085) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n}\n\n/* Quick Access \u2014 light glass, do NOT force solid black */\nbody.theme-liquid-glass #quick-access {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.12) 0%,\n      rgba(255,255,255,.035) 48%,\n      rgba(255,255,255,.085) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n  color: var(--text) !important;\n}\n\n/* Windows */\nbody.theme-liquid-glass .window {\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.105) 0%,\n      rgba(255,255,255,.028) 52%,\n      rgba(255,255,255,.075) 100%\n    ) !important;\n  border-color: var(--lg-border) !important;\n  box-shadow: var(--lg-shadow) !important;\n  backdrop-filter: var(--blur) !important;\n  -webkit-backdrop-filter: var(--blur) !important;\n}\n\nbody.theme-liquid-glass .win-header,\nbody.theme-liquid-glass .jade-toolbar,\nbody.theme-liquid-glass .studio-menubar,\nbody.theme-liquid-glass .studio-toolbar {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.10),\n      rgba(255,255,255,.028)\n    ) !important;\n  border-color: rgba(255,255,255,.13) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .68)) saturate(165%) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .68)) saturate(165%) !important;\n}\n\nbody.theme-liquid-glass .win-content,\nbody.theme-liquid-glass .jade-sidebar,\nbody.theme-liquid-glass .sm-body,\nbody.theme-liquid-glass .sm-main {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.018),\n      rgba(255,255,255,.005)\n    ) !important;\n}\n\nbody.theme-liquid-glass .jade-sidebar,\nbody.theme-liquid-glass .sm-side {\n  background: rgba(255,255,255,.035) !important;\n  border-color: rgba(255,255,255,.12) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .60)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .60)) !important;\n}\n\n/* Interactive surfaces */\nbody.theme-liquid-glass .tb-start-btn,\nbody.theme-liquid-glass .tb-app-btn,\nbody.theme-liquid-glass .sm-tile,\nbody.theme-liquid-glass .sm-list-item,\nbody.theme-liquid-glass .sm-app,\nbody.theme-liquid-glass .sm-search,\nbody.theme-liquid-glass .sm-side button,\nbody.theme-liquid-glass .qa-chip,\nbody.theme-liquid-glass .qa-st,\nbody.theme-liquid-glass .qa-tile,\nbody.theme-liquid-glass .qa-slider-block,\nbody.theme-liquid-glass .qa-slider-row,\nbody.theme-liquid-glass .wp-preset-card,\nbody.theme-liquid-glass .store-item,\nbody.theme-liquid-glass .tb-instance-card,\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar) .bubble-btn {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    ) !important;\n  border-color: rgba(255,255,255,.13) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.09) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .58)) saturate(155%) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .58)) saturate(155%) !important;\n}\n\nbody.theme-liquid-glass .tb-start-btn,\nbody.theme-liquid-glass .tb-app-btn,\nbody.theme-liquid-glass .sm-tile,\nbody.theme-liquid-glass .sm-list-item,\nbody.theme-liquid-glass .sm-app,\nbody.theme-liquid-glass .qa-chip,\nbody.theme-liquid-glass .qa-tile,\nbody.theme-liquid-glass .wp-preset-card,\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar) .bubble-btn {\n  transition:\n    background var(--anim),\n    border-color var(--anim),\n    box-shadow var(--anim),\n    transform var(--anim),\n    opacity var(--anim);\n}\n\nbody.theme-liquid-glass .tb-start-btn:hover,\nbody.theme-liquid-glass .tb-app-btn:hover,\nbody.theme-liquid-glass .sm-tile:hover,\nbody.theme-liquid-glass .sm-list-item:hover,\nbody.theme-liquid-glass .sm-app:hover,\nbody.theme-liquid-glass .qa-chip:hover,\nbody.theme-liquid-glass .qa-tile:hover,\nbody.theme-liquid-glass .wp-preset-card:hover,\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar) .bubble-btn:hover {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.16),\n      rgba(255,255,255,.045)\n    ) !important;\n  border-color: var(--lg-border-strong) !important;\n  box-shadow:\n    0 8px 24px rgba(0,0,0,.11),\n    inset 0 1px 0 rgba(255,255,255,.19) !important;\n}\n\n/* Liquid highlight \u2014 never on pin-topbar */\nbody.theme-liquid-glass #start-menu::after,\nbody.theme-liquid-glass #quick-access::after,\nbody.theme-liquid-glass .window::after,\nbody.theme-liquid-glass .mica-modal-card::after,\nbody.theme-liquid-glass #vertical-bubble:not(.pin-topbar)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  border-radius: inherit;\n  background:\n    radial-gradient(\n      115% 70% at calc(15% + (var(--lg-warp) * .55)% ) -8%,\n      rgba(255,255,255,.18),\n      transparent 42%\n    ),\n    radial-gradient(\n      80% 90% at calc(92% - (var(--lg-warp) * .25)% ) 110%,\n      rgba(110,185,255,.08),\n      transparent 46%\n    );\n  opacity: calc(.35 + (var(--lg-warp) * .006));\n  mix-blend-mode: screen;\n}\n\nbody.theme-liquid-glass input,\nbody.theme-liquid-glass textarea,\nbody.theme-liquid-glass select {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    ) !important;\n  border-color: rgba(255,255,255,.16) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.09) !important;\n  backdrop-filter: blur(calc(var(--lg-blur) * .48)) !important;\n  -webkit-backdrop-filter: blur(calc(var(--lg-blur) * .48)) !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass input::placeholder,\nbody.theme-liquid-glass textarea::placeholder {\n  color: color-mix(in srgb, var(--text) 55%, transparent);\n  opacity: 1;\n}\n\nbody.theme-liquid-glass button {\n  transition:\n    background var(--anim),\n    border-color var(--anim),\n    box-shadow var(--anim),\n    transform var(--anim),\n    opacity var(--anim);\n}\n\n/* Menus */\nbody.theme-liquid-glass .topbar-dd-menu,\nbody.theme-liquid-glass .studio-dd-menu,\nbody.theme-liquid-glass .mica-ctx,\nbody.theme-liquid-glass .context-menu,\nbody.theme-liquid-glass .mica-menu {\n  background:\n    linear-gradient(\n      160deg,\n      rgba(36, 38, 46, 0.92) 0%,\n      rgba(22, 24, 30, 0.94) 100%\n    ) !important;\n  border: 1px solid rgba(255,255,255,0.14) !important;\n  border-radius: 12px !important;\n  box-shadow:\n    0 16px 40px rgba(0,0,0,0.38),\n    inset 0 1px 0 rgba(255,255,255,0.10) !important;\n  backdrop-filter: blur(22px) saturate(160%) !important;\n  -webkit-backdrop-filter: blur(22px) saturate(160%) !important;\n  padding: 6px !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass .topbar-dd-item,\nbody.theme-liquid-glass .context-item,\nbody.theme-liquid-glass .mica-ctx .context-item {\n  border-radius: 8px !important;\n  padding: 8px 12px !important;\n  margin: 0 2px !important;\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  color: var(--text) !important;\n}\n\nbody.theme-liquid-glass .topbar-dd-item:hover,\nbody.theme-liquid-glass .context-item:hover,\nbody.theme-liquid-glass .mica-ctx .context-item:hover {\n  background: rgba(255,255,255,0.10) !important;\n}\n\n/* MicaTasking \u2014 soft under-list only */\nbody.theme-liquid-glass .mc-under-app {\n  background: rgba(255,255,255,0.045) !important;\n  border: 1px solid transparent !important;\n  box-shadow: none !important;\n  color: rgba(243,246,251,0.92) !important;\n  border-radius: 8px !important;\n}\nbody.theme-liquid-glass .mc-under-app:hover {\n  background: rgba(255,255,255,0.10) !important;\n  border-color: rgba(255,255,255,0.08) !important;\n}\n\n/* mpkg colour helpers */\nbody.theme-liquid-glass select,\nbody.theme-liquid-glass select option {\n  background-color: #2a2a2e !important;\n  color: #eee !important;\n}\n\nbody.theme-liquid-glass .primary-btn {\n  background: var(--text) !important;\n  color: var(--win-bg) !important;\n  border: none !important;\n}\nbody.theme-liquid-glass .primary-btn:hover {\n  background: var(--accent, #9cc9ff) !important;\n  color: #0a0b0c !important;\n}\n\nbody.theme-liquid-glass,\nbody.theme-liquid-glass .window,\nbody.theme-liquid-glass .win-header,\nbody.theme-liquid-glass .win-content {\n  color: var(--text);\n}\n\nbody.theme-liquid-glass #start-menu.open,\nbody.theme-liquid-glass #quick-access.open {\n  animation: mplgGlassIn 280ms cubic-bezier(.16,1,.3,1) both;\n}\n\n@keyframes mplgGlassIn {\n  from { opacity: 0; transform: translateY(8px) scale(.985); filter: blur(3px); }\n  to   { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  body.theme-liquid-glass #start-menu.open,\n  body.theme-liquid-glass #quick-access.open {\n    animation: none !important;\n  }\n}\n`;\n  document.head.appendChild(style);\n}\n\nfunction applyGlassVars() {\n  const blur = num(STORAGE.blur, defaults.blur, 8, 52);\n  const warp = num(STORAGE.warp, defaults.warp, 0, 100);\n  const motion = num(STORAGE.motion, defaults.motion, 40, 220);\n\n  document.documentElement.style.setProperty('--mplug-lg-blur', blur + 'px');\n  document.documentElement.style.setProperty('--mplug-lg-warp', String(warp));\n  document.documentElement.style.setProperty('--mplug-lg-motion', motion + 'ms');\n\n  if (document.body) {\n    document.body.style.setProperty('--lg-blur', blur + 'px');\n    document.body.style.setProperty('--lg-warp', String(warp));\n    document.body.style.setProperty('--lg-motion', motion + 'ms');\n  }\n  return { blur, warp, motion };\n}\n\n/* ============================================================\n   RUNTIME FIXES (code, not theme CSS wars)\n   ============================================================ */\n\n/** OS paints qa-mode-drop white for any non-builtin dark theme.\n *  Fix by treating liquid-glass like a dark theme at runtime. */\nfunction fixControlCentrePanel(qa) {\n  if (!qa || !isLiquidActive()) return;\n\n  // Match OS dark drop-mode look (see style.css #quick-access.qa-mode-drop)\n  const darkDrop = 'rgba(40,40,44,0.82)';\n  const glassBorder = '1px solid rgba(255,255,255,0.14)';\n  const text = getComputedStyle(document.body).getPropertyValue('--text').trim() || '#f3f6fb';\n\n  if (qa.classList.contains('qa-mode-drop')) {\n    qa.style.setProperty('background', darkDrop, 'important');\n    qa.style.setProperty('color', text, 'important');\n    qa.style.setProperty('border', glassBorder, 'important');\n    qa.style.setProperty('backdrop-filter', 'blur(22px) saturate(1.3)', 'important');\n    qa.style.setProperty('-webkit-backdrop-filter', 'blur(22px) saturate(1.3)', 'important');\n  } else {\n    // Clear forced drop styles when leaving drop mode\n    qa.style.removeProperty('background');\n    qa.style.removeProperty('color');\n    qa.style.removeProperty('border');\n    qa.style.removeProperty('backdrop-filter');\n    qa.style.removeProperty('-webkit-backdrop-filter');\n  }\n\n  // Cards inside CC stay readable\n  qa.querySelectorAll('.qa-cc-card, .qa-cc-section').forEach(el => {\n    el.style.setProperty('background', 'rgba(128,128,128,0.16)', 'important');\n    el.style.setProperty('color', text, 'important');\n    el.style.setProperty('border-color', 'rgba(255,255,255,0.08)', 'important');\n  });\n  qa.querySelectorAll('.qa-cc-card:not(.qa-cc-wide)').forEach(el => {\n    if (!el.dataset.lgHoverBound) {\n      el.dataset.lgHoverBound = '1';\n      el.addEventListener('mouseenter', () => {\n        if (isLiquidActive()) el.style.setProperty('background', 'rgba(128,128,128,0.28)', 'important');\n      });\n      el.addEventListener('mouseleave', () => {\n        if (isLiquidActive()) el.style.setProperty('background', 'rgba(128,128,128,0.16)', 'important');\n      });\n    }\n  });\n}\n\n/** Keep topbar bubble geometry intact \u2014 strip plugin visual residue. */\nfunction fixTopbarBubble() {\n  if (!isLiquidActive()) return;\n  const bubble = document.getElementById('vertical-bubble');\n  if (!bubble) return;\n\n  if (bubble.classList.contains('pin-topbar') || document.body.classList.contains('bubble-pin-topbar')) {\n    // Let OS rules own layout; only ensure a readable dark glass strip\n    bubble.style.setProperty('background', 'rgba(28, 28, 30, 0.72)', 'important');\n    bubble.style.setProperty('backdrop-filter', 'blur(40px) saturate(1.6)', 'important');\n    bubble.style.setProperty('-webkit-backdrop-filter', 'blur(40px) saturate(1.6)', 'important');\n    bubble.style.setProperty('border', 'none', 'important');\n    bubble.style.setProperty('border-bottom', '1px solid rgba(255,255,255,0.1)', 'important');\n    bubble.style.setProperty('box-shadow', 'none', 'important');\n    bubble.style.setProperty('border-radius', '0', 'important');\n\n    // Micro-controls: no card chrome\n    bubble.querySelectorAll('.bubble-btn, .topbar-menu-item, .topbar-status, .topbar-clock, .topbar-brand, .topbar-pin-btn, .topbar-slot').forEach(el => {\n      el.style.setProperty('background', 'transparent', 'important');\n      el.style.setProperty('box-shadow', 'none', 'important');\n      el.style.setProperty('border', 'none', 'important');\n      el.style.setProperty('backdrop-filter', 'none', 'important');\n      el.style.setProperty('-webkit-backdrop-filter', 'none', 'important');\n    });\n  } else {\n    // Leaving topbar mode \u2014 clear inline overrides so theme CSS applies again\n    ['background', 'backdrop-filter', '-webkit-backdrop-filter', 'border', 'border-bottom', 'box-shadow', 'border-radius'].forEach(p => {\n      bubble.style.removeProperty(p);\n    });\n  }\n}\n\nfunction installRuntimeFixes() {\n  // One surgical CSS rule: cancel the OS light-theme white drop panel\n  if (!document.getElementById(FIX_STYLE_ID)) {\n    const s = document.createElement('style');\n    s.id = FIX_STYLE_ID;\n    s.textContent = `\n/* Runtime: liquid-glass is a dark theme for Control Centre drop mode only */\nbody.theme-liquid-glass #quick-access.qa-mode-drop {\n  background: rgba(40,40,44,0.82) !important;\n  color: var(--text, #f3f6fb) !important;\n}\nbody.theme-liquid-glass #quick-access.qa-mode-drop .qa-cc-card {\n  background: rgba(128,128,128,0.16) !important;\n  color: var(--text, #f3f6fb) !important;\n  border-color: rgba(255,255,255,0.08) !important;\n}\nbody.theme-liquid-glass #quick-access.qa-mode-drop .qa-cc-card:not(.qa-cc-wide):hover {\n  background: rgba(128,128,128,0.28) !important;\n}\nbody.theme-liquid-glass.bubble-pin-topbar #vertical-bubble.pin-topbar::after {\n  content: none !important;\n  display: none !important;\n}\n`;\n    document.head.appendChild(s);\n  }\n\n  const run = () => {\n    if (!isLiquidActive()) return;\n    fixTopbarBubble();\n    const qa = document.getElementById('quick-access');\n    if (qa) fixControlCentrePanel(qa);\n  };\n\n  run();\n\n  const obs = new MutationObserver(() => {\n    run();\n  });\n  obs.observe(document.body, {\n    attributes: true,\n    attributeFilter: ['class'],\n    childList: true,\n    subtree: true\n  });\n\n  // Also re-run when quick access is toggled open\n  document.addEventListener('click', () => {\n    setTimeout(run, 30);\n  }, true);\n}\n\nasync function ensureLiquidTheme() {\n  if (typeof API === 'undefined' || !API.token || typeof API.themesSave !== 'function') return;\n\n  try {\n    const vars = [\n      '--bg:linear-gradient(135deg,#17202b 0%,#090b10 100%)',\n      '--win-bg:#1c1d22',\n      '--text:#f3f6fb',\n      '--input-bg:rgba(255,255,255,.055)',\n      '--dock-bg:rgba(20,20,24,.56)',\n      '--dock-border:rgba(255,255,255,.19)',\n      '--well-bg:rgba(255,255,255,.075)',\n      '--accent:#9cc9ff'\n    ].join(';');\n\n    const payload = {\n      id: 'theme-liquid-glass',\n      name: 'Liquid Glass',\n      cssClass: 'theme-liquid-glass',\n      cssVariables: vars,\n      bg: 'linear-gradient(135deg,#17202b 0%,#090b10 100%)',\n      text: '#f3f6fb'\n    };\n\n    await API.themesSave(payload);\n\n    const activeCls = localStorage.getItem('mica_theme') || '';\n    if (activeCls === 'theme-liquid-glass' && typeof applyThemeObject === 'function') {\n      applyThemeObject(payload, true);\n    }\n  } catch (e) {\n    console.warn('[Liquid Glass] theme registration failed', e);\n  }\n}\n\nfunction installThemePickerRefresh() {\n  const observer = new MutationObserver(() => {\n    document.querySelectorAll('[id^=\"set_themes_\"]').forEach(el => {\n      if (el.dataset.lgPatched === '1') return;\n      if ((el.textContent || '').includes('Liquid Glass')) el.dataset.lgPatched = '1';\n    });\n    patchAppearanceViews();\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n}\n\nfunction patchAppearanceViews() {\n  document.querySelectorAll('[id^=\"set_view_\"]').forEach(view => {\n    if (!(view.textContent || '').includes('Appearance')) return;\n    if (view.querySelector('.mplug-liquid-settings')) return;\n\n    const card = document.createElement('div');\n    card.className = 'mplug-liquid-settings';\n    card.innerHTML = `\n      <div style=\"\n        margin-top:16px;padding:14px;\n        border:1px solid rgba(255,255,255,.13);border-radius:14px;\n        background:rgba(255,255,255,.035);\n        box-shadow:inset 0 1px rgba(255,255,255,.08);\n      \">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;\">\n          <div>\n            <div style=\"font-size:14px;font-weight:700;\">\ud83e\udee7 Liquid Glass</div>\n            <div style=\"font-size:11px;opacity:.55;margin-top:3px;\">\n              Glass-only controls. Applied when the Liquid Glass system theme is selected.\n            </div>\n          </div>\n          <span style=\"font-size:10px;opacity:.5;\">THEME</span>\n        </div>\n        <div style=\"height:10px;\"></div>\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px;\">\n          <span>Blur</span>\n          <b id=\"mplug-lg-blur-value\">28px</b>\n        </label>\n        <input id=\"mplug-lg-blur\" type=\"range\" min=\"8\" max=\"52\" step=\"1\" style=\"width:100%;\">\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin:13px 0 5px;\">\n          <span>Warp / refraction</span>\n          <b id=\"mplug-lg-warp-value\">38%</b>\n        </label>\n        <input id=\"mplug-lg-warp\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" style=\"width:100%;\">\n        <label style=\"display:flex;justify-content:space-between;font-size:12px;margin:13px 0 5px;\">\n          <span>Animation smoothness</span>\n          <b id=\"mplug-lg-motion-value\">100ms</b>\n        </label>\n        <input id=\"mplug-lg-motion\" type=\"range\" min=\"40\" max=\"220\" step=\"5\" style=\"width:100%;\">\n        <div style=\"display:flex;gap:7px;margin-top:13px;\">\n          <button type=\"button\" class=\"primary-btn\" id=\"mplug-lg-reset\" style=\"flex:1;padding:8px;\">Reset</button>\n        </div>\n      </div>\n    `;\n    view.appendChild(card);\n\n    const blur = card.querySelector('#mplug-lg-blur');\n    const warp = card.querySelector('#mplug-lg-warp');\n    const motion = card.querySelector('#mplug-lg-motion');\n    const bv = card.querySelector('#mplug-lg-blur-value');\n    const wv = card.querySelector('#mplug-lg-warp-value');\n    const mv = card.querySelector('#mplug-lg-motion-value');\n\n    function sync() {\n      const v = applyGlassVars();\n      blur.value = v.blur;\n      warp.value = v.warp;\n      motion.value = v.motion;\n      bv.textContent = v.blur + 'px';\n      wv.textContent = v.warp + '%';\n      mv.textContent = v.motion + 'ms';\n    }\n\n    blur.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.blur, blur.value);\n      sync();\n    });\n    warp.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.warp, warp.value);\n      sync();\n    });\n    motion.addEventListener('input', () => {\n      localStorage.setItem(STORAGE.motion, motion.value);\n      sync();\n    });\n    card.querySelector('#mplug-lg-reset').addEventListener('click', () => {\n      localStorage.setItem(STORAGE.blur, defaults.blur);\n      localStorage.setItem(STORAGE.warp, defaults.warp);\n      localStorage.setItem(STORAGE.motion, defaults.motion);\n      sync();\n    });\n    sync();\n  });\n}\n\nasync function boot() {\n  ensureCSS();\n  applyGlassVars();\n  installThemePickerRefresh();\n  patchAppearanceViews();\n  installRuntimeFixes();\n  await ensureLiquidTheme();\n  // Re-run fixes after theme apply\n  setTimeout(() => {\n    if (typeof installRuntimeFixes === 'function') {\n      const qa = document.getElementById('quick-access');\n      if (qa) fixControlCentrePanel(qa);\n      fixTopbarBubble();\n    }\n  }, 400);\n}\n\nboot();\nconsole.log('[Mica Plugin] Liquid Glass Theme v3.2.0 loaded');\n})();\n"
}